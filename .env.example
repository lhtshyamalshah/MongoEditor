# Existing DB and TENANT_DB strings are discovered automatically.
DB=mongodb://username:password@host:27017/database?authSource=admin
TENANT_DB=mongodb://username:password@host:27017/tenant_database?authSource=admin
# Optional alternative connection profile:
# MONGODB_URI=mongodb://localhost:27017/my_database
# Optional default database override:
# MONGODB_DATABASE=my_database
# DocumentDB automatically uses TLS and global-bundle.pem.
# MONGODB_TLS_CA_FILE=global-bundle.pem

# PostgreSQL profiles (postgres:// is also supported):
# POSTGRESQL_URI=postgresql://username:password@localhost:5432/my_database
# POSTGRES_URI=postgresql://username:password@host:5432/my_database?sslmode=verify-full
# DATABASE_URL=postgresql://username:password@localhost:5432/my_database
# POSTGRES_DATABASE=my_database
# DB and TENANT_DB can also contain PostgreSQL URIs.
